DATABASE_URL="file:./dev.db"

# Comma-separated web origins allowed to call the local API.
# Use "*" only if you explicitly want to allow any browser origin.
CORS_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"

# Keep the API local-only by default, even if HOST is changed.
# Set to "true" only when you intentionally expose the API on your LAN.
ALLOW_REMOTE_API="false"

# Required whenever ALLOW_REMOTE_API=true. The server rejects remote mode when
# this is empty. Remote requests must send `Authorization: Bearer ...`;
# local loopback requests do not need the token.
# Generate one with: openssl rand -hex 32
API_ACCESS_TOKEN=""

# JSON and urlencoded request body limit. Defaults to 50mb.
API_BODY_LIMIT="50mb"

# Optional persisted scan-job status file. Defaults to ./.moxu/scan-jobs.json.
SCAN_JOBS_FILE=""

# Used to encrypt the persisted AI API key in the local SQLite database.
AI_CONFIG_SECRET="replace-with-a-long-random-secret"

# Optional OpenAI-compatible chat config.
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""
# Whole-request timeout for chat responses/streams (1s-5min, default 60s).
AI_REQUEST_TIMEOUT_MS="60000"

# Optional OpenAI-compatible embedding config for stronger RAG retrieval.
# If no embedding API key is configured, the server falls back to local hash embeddings.
AI_EMBEDDING_PROVIDER="local"
AI_EMBEDDING_BASE_URL="https://api.openai.com/v1"
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_EMBEDDING_API_KEY=""
# Per-request embedding timeout (1s-5min, default 30s).
AI_EMBEDDING_TIMEOUT_MS="30000"

# Optional defaults for RAG retrieval.
AI_RAG_SOURCE_COUNT="5"
AI_RAG_CONTEXT_CHARS="12000"
AI_RAG_EXCERPT_CHARS="520"
