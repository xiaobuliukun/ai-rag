DATABASE_URL="file:./dev.db"

# Used to encrypt the persisted AI API key in the local SQLite database.
AI_CONFIG_SECRET="replace-with-a-long-random-secret"

# Optional OpenAI-compatible chat config.
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""

# Optional OpenAI-compatible embedding config for stronger RAG retrieval.
# If no embedding API key is configured, the server falls back to local hash embeddings.
AI_EMBEDDING_PROVIDER="local"
AI_EMBEDDING_BASE_URL="https://api.openai.com/v1"
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_EMBEDDING_API_KEY=""

# Optional defaults for RAG retrieval.
AI_RAG_SOURCE_COUNT="5"
AI_RAG_CONTEXT_CHARS="12000"
AI_RAG_EXCERPT_CHARS="520"
