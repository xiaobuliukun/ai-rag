{
  "name": "@moxu/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for Moxu",
  "main": "src/main.cjs",
  "author": "Moxu",
  "scripts": {
    "dev": "electron .",
    "test": "node --test test/*.test.cjs",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish never",
    "dist:mac:signed": "electron-builder --mac dmg zip --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.6",
    "electron": "39.8.10",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.moxu.desktop",
    "productName": "墨序",
    "beforePack": "./scripts/before-pack.cjs",
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "../../release/desktop"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../.moxu/desktop-runtime/package.json",
        "to": "runtime/package.json"
      },
      {
        "from": "../../.moxu/desktop-runtime/node_modules",
        "to": "runtime/node_modules"
      },
      {
        "from": "../../.moxu/desktop-runtime/packages",
        "to": "runtime/packages"
      },
      {
        "from": "../../.moxu/desktop-runtime/web",
        "to": "runtime/web"
      },
      {
        "from": "../../.moxu/desktop-runtime/web/node_modules",
        "to": "runtime/web/node_modules"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "Moxu-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Moxu-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Education",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Moxu-${version}-${arch}.${ext}"
    }
  }
}
