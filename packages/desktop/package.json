{
  "name": "@moxu/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for Moxu",
  "main": "src/main.cjs",
  "author": "xiaobuliukun <xiaobuliukun@gmail.com>",
  "homepage": "https://github.com/xiaobuliukun/ai-rag",
  "scripts": {
    "dev": "electron .",
    "test": "node --test test/*.test.cjs",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish never",
    "release:check:mac": "node scripts/release-security.cjs preflight",
    "release:verify:mac": "node scripts/release-security.cjs verify ../../release/desktop",
    "dist:mac:signed": "npm run release:check:mac && electron-builder --mac dmg zip --publish never && npm run release:verify:mac",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.moxu.desktop",
    "productName": "墨序",
    "beforePack": "./scripts/before-pack.cjs",
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "../../release/desktop"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../.moxu/desktop-runtime/package.json",
        "to": "runtime/package.json"
      },
      {
        "from": "../../.moxu/desktop-runtime/node_modules",
        "to": "runtime/node_modules"
      },
      {
        "from": "../../.moxu/desktop-runtime/packages",
        "to": "runtime/packages"
      },
      {
        "from": "../../.moxu/desktop-runtime/web",
        "to": "runtime/web"
      },
      {
        "from": "../../.moxu/desktop-runtime/web/node_modules",
        "to": "runtime/web/node_modules"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "xiaobuliukun",
        "repo": "ai-rag",
        "channel": "latest",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "artifactName": "Moxu-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "Moxu-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Moxu-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Moxu-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Education",
      "icon": "build/icon.png",
      "maintainer": "xiaobuliukun <xiaobuliukun@gmail.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Moxu-${version}-${arch}.${ext}"
    }
  }
}
