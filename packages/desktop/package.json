{
  "name": "@moxu/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for Moxu",
  "main": "src/main.cjs",
  "author": "xiaobuliukun <xiaobuliukun@gmail.com>",
  "homepage": "https://github.com/xiaobuliukun/ai-rag",
  "scripts": {
    "dev": "npm run build -w @moxu/shared && npm run build -w @moxu/server && npm run build:renderer && npm run prepare:runtime && electron .",
    "build": "npm run build:renderer",
    "build:renderer": "node renderer/build.cjs",
    "dev:renderer": "node renderer/build.cjs --watch",
    "test": "node --test test/*.test.cjs",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "pack": "npm run build:renderer && electron-builder --dir --publish never",
    "dist": "npm run build:renderer && electron-builder --publish never",
    "dist:mac": "npm run build:renderer && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish never",
    "release:check:mac": "node scripts/release-security.cjs preflight",
    "release:verify:mac": "node scripts/release-security.cjs verify ../../release/desktop",
    "dist:mac:signed": "npm run build:renderer && npm run release:check:mac && electron-builder --mac dmg zip --publish never && npm run release:verify:mac",
    "dist:win": "npm run build:renderer && electron-builder --win nsis portable --publish never",
    "dist:linux": "npm run build:renderer && electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@moxu/shared": "*",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4",
    "ts-loader": "^9.5.4",
    "typescript": "^5",
    "webpack": "^5.106.2",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "build": {
    "appId": "app.moxu.desktop",
    "productName": "墨序",
    "beforePack": "./scripts/before-pack.cjs",
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "../../release/desktop"
    },
    "files": [
      "src/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../.moxu/desktop-runtime/package.json",
        "to": "runtime/package.json"
      },
      {
        "from": "../../.moxu/desktop-runtime/node_modules",
        "to": "runtime/node_modules"
      },
      {
        "from": "../../.moxu/desktop-runtime/packages",
        "to": "runtime/packages"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "xiaobuliukun",
        "repo": "ai-rag",
        "channel": "latest",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "artifactName": "Moxu-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "Moxu-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Moxu-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Moxu-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Education",
      "icon": "build/icon.png",
      "maintainer": "xiaobuliukun <xiaobuliukun@gmail.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Moxu-${version}-${arch}.${ext}"
    }
  }
}
