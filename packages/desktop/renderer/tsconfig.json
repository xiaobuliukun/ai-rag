{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": false,
    "baseUrl": "../../web",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"]
}
